@import "../omarchy/current/theme/swayosd.css";

@define-color theme_bg_color @background-color;
@define-color theme_fg_color @label;
@define-color theme_base_color @background-color;
@define-color theme_text_color @label;
@define-color theme_selected_bg_color @border-color;
@define-color theme_selected_fg_color @background-color;
@define-color accent_bg_color @border-color;
@define-color accent_fg_color @background-color;
@define-color borders alpha(@border-color, 0.72);
@define-color insensitive_bg_color alpha(@label, 0.06);
@define-color insensitive_fg_color alpha(@label, 0.44);
@define-color hover_bg_color alpha(@border-color, 0.18);
@define-color active_bg_color alpha(@border-color, 0.28);
@define-color button_bg_color alpha(@label, 0.08);
@define-color button_border_color alpha(@border-color, 0.42);
@define-color error_color #ffafcc;

* {
  font-family: "JetBrainsMono Nerd Font";
  font-size: 12px;
  color: @label;
  background-clip: padding-box;
  outline-color: transparent;
}

.control-center,
.notification-row .notification-background,
.floating-notifications .notification {
  background: alpha(@background-color, 0.96);
  border: 1px solid alpha(@border-color, 0.72);
  border-radius: 8px;
  box-shadow: none;
}

.control-center {
  padding: 10px;
}

.notification-row {
  outline: none;
}

.notification-row:hover,
.notification-row:focus {
  background: transparent;
}

.notification-row:hover .notification-background,
.notification-row:focus .notification-background {
  background: @hover_bg_color;
  border-color: @border-color;
}

.notification-row:active .notification-background {
  background: @active_bg_color;
}

.notification-row .notification-background {
  margin: 6px 8px;
  padding: 0;
}

.notification {
  padding: 10px;
}

.notification-content {
  margin: 0;
  padding: 0;
}

.summary {
  font-weight: 700;
}

.time,
.body {
  color: alpha(@label, 0.78);
}

.close-button,
.notification-action,
.widget-title button,
.widget-dnd switch,
.widget-inhibitors button {
  background: @button_bg_color;
  border: 1px solid @button_border_color;
  border-radius: 6px;
  color: @label;
}

.close-button:hover,
.notification-action:hover,
.widget-title button:hover,
.widget-inhibitors button:hover {
  background: @hover_bg_color;
  border-color: @border-color;
}

.close-button:active,
.notification-action:active,
.widget-title button:active,
.widget-inhibitors button:active {
  background: @active_bg_color;
}

.notification.critical {
  border-left: 3px solid @error_color;
}

.notification.low {
  opacity: 0.82;
}

.widget-title,
.widget-dnd,
.widget-inhibitors,
.widget-mpris,
.widget-notifications {
  background: transparent;
  margin: 0 0 8px;
}

.widget-title {
  font-weight: 700;
}

.widget-dnd switch:checked {
  background: alpha(@border-color, 0.72);
}

.widget-dnd switch:hover {
  background: @hover_bg_color;
}

.widget-dnd switch:checked:hover {
  background: @border-color;
}

.widget-dnd switch slider {
  background: @label;
}

.widget-mpris {
  border: 1px solid alpha(@border-color, 0.34);
  border-radius: 8px;
  padding: 8px;
}

scrollbar,
scrollbar trough {
  background: transparent;
  border: none;
}

scrollbar slider {
  background: @button_bg_color;
  border-radius: 999px;
  min-width: 6px;
  min-height: 6px;
}

scrollbar slider:hover {
  background: @hover_bg_color;
}
