[user]
	name = jrtilak
	email = contact@jrtilak.dev

[pull]
	rebase = false

[init]
	defaultBranch = master

[push]
  autoSetupRemote = true

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true

[merge]
    conflictStyle = zdiff3
