{
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "control-center-layer": "overlay",
  "control-center-margin-top": 34,
  "control-center-margin-right": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-left": 8,
  "control-center-exclusive-zone": false,
  "notification-window-width": 420,
  "notification-window-height": -1,
  "control-center-width": 420,
  "control-center-height": 650,
  "fit-to-screen": true,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "hide-on-action": true,
  "hide-on-clear": false,
  "text-empty": "No notifications",
  "relative-timestamps": true,
  "notification-2fa-action": true,
  "widgets": ["title", "dnd", "inhibitors", "mpris", "notifications"],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "inhibitors": {
      "text": "Inhibitors",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true
    }
  },
  "scripts": {
    "notification-sound": {
      "exec": "/home/jrtilak/.config/swaync/play-sound",
      "urgency": "Normal|Critical"
    }
  }
}
