;; jrtilak-layout, based on the ShelZuuz tablet experiment.
;; QWERTY letters; [ = Backspace; apostrophe = Enter in EVERY layer.
;; Caps once selects one symbol; Caps twice within 320 ms toggles Numbers.
;; Symbols-from-ABC and symbols-from-Numbers are two internal states of ONE
;; logical Symbols layer. Each non-modifier output restores its remembered base.
;; The original number row, far Backspace/Enter, ] and backslash are disabled.
;; Escape, function/navigation/media keys and modifiers remain usable.
;; No one-shot timeout: a symbol waits until a key is used.
;; Ctrl+Space+Escape (physical keys) exits Kanata immediately.
(defcfg
  process-unmapped-keys yes
  delegate-to-first-layer yes
  linux-continue-if-no-devs-found yes
  linux-output-device-name "jrtilak-layout"
  linux-dev-names-exclude ("jrtilak-layout" "kanata" "wtype virtual keyboard")
)
(defalias
  caps-abc (tap-dance-eager 320 ((layer-switch symbols-abc) (layer-switch numeric)))
  caps-num (tap-dance-eager 320 ((layer-switch symbols-num) (layer-switch abc)))
  ;; A later isolated Caps cancels Symbols; an in-progress double tap uses
  ;; the original eager dance and still toggles the persistent base.
  caps-sym-abc (tap-dance-eager 320 ((layer-switch abc) (layer-switch numeric)))
  caps-sym-num (tap-dance-eager 320 ((layer-switch numeric) (layer-switch abc)))
  ;; L gives double quote; physical Shift+L gives apostrophe.
  quote (fork (unshift lsft ') (unshift ') (lsft rsft))
)

(defsrc
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q w e r t y u i o p [ ] \
  caps a s d f g h j k l ; ' ret
  lsft z x c v b n m , . / rsft
  lctl lmet lalt spc ralt rmet rctl
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins del home end pgup pgdn left down up rght
)

(deflayer abc
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  tab q w e r t y u i o p bspc XX XX
  @caps-abc a s d f g h j k l ; ret XX
  lsft z x c v b n m , . / rsft
  lctl lmet lalt spc ralt rmet rctl
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins del home end pgup pgdn left down up rght
)

(deflayer numeric
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  tab XX XX XX XX XX XX left down up rght bspc XX XX
  @caps-num (unshift 1) (unshift 2) (unshift 3) (unshift 4) (unshift 5) (unshift 6) (unshift 7) (unshift 8) (unshift 9) (unshift 0) ret XX
  lsft XX XX XX XX XX XX XX , . / rsft
  lctl lmet lalt spc ralt rmet rctl
  esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 ins del home end pgup pgdn left down up rght
)

(deflayer symbols-abc
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  (multi tab (layer-switch abc)) (multi (unshift grv) (layer-switch abc)) (multi (unshift lsft grv) (layer-switch abc)) (multi (unshift lsft 3) (layer-switch abc)) (multi (unshift lsft 7) (layer-switch abc)) (multi (unshift lsft \) (layer-switch abc)) (multi (unshift lsft 6) (layer-switch abc)) (multi (unshift lsft [) (layer-switch abc)) (multi (unshift lsft ]) (layer-switch abc)) (multi (unshift [) (layer-switch abc)) (multi (unshift ]) (layer-switch abc)) (multi bspc (layer-switch abc)) XX XX
  @caps-sym-abc (multi (unshift lsft 1) (layer-switch abc)) (multi (unshift lsft -) (layer-switch abc)) (multi (unshift lsft ;) (layer-switch abc)) (multi (unshift =) (layer-switch abc)) (multi (unshift lsft 4) (layer-switch abc)) (multi (unshift lsft 2) (layer-switch abc)) (multi (unshift lsft 9) (layer-switch abc)) (multi (unshift lsft 0) (layer-switch abc)) (multi @quote (layer-switch abc)) (multi ; (layer-switch abc)) (multi ret (layer-switch abc)) XX
  lsft (multi (unshift lsft 5) (layer-switch abc)) (multi (unshift lsft /) (layer-switch abc)) (multi (unshift lsft 8) (layer-switch abc)) (multi (unshift lsft =) (layer-switch abc)) (multi (unshift \) (layer-switch abc)) (multi (unshift /) (layer-switch abc)) (multi (unshift -) (layer-switch abc)) (multi , (layer-switch abc)) (multi . (layer-switch abc)) (multi / (layer-switch abc)) rsft
  lctl lmet lalt (multi spc (layer-switch abc)) ralt rmet rctl
  (multi esc (layer-switch abc)) (multi f1 (layer-switch abc)) (multi f2 (layer-switch abc)) (multi f3 (layer-switch abc)) (multi f4 (layer-switch abc)) (multi f5 (layer-switch abc)) (multi f6 (layer-switch abc)) (multi f7 (layer-switch abc)) (multi f8 (layer-switch abc)) (multi f9 (layer-switch abc)) (multi f10 (layer-switch abc)) (multi f11 (layer-switch abc)) (multi f12 (layer-switch abc)) (multi ins (layer-switch abc)) (multi del (layer-switch abc)) (multi home (layer-switch abc)) (multi end (layer-switch abc)) (multi pgup (layer-switch abc)) (multi pgdn (layer-switch abc)) (multi left (layer-switch abc)) (multi down (layer-switch abc)) (multi up (layer-switch abc)) (multi rght (layer-switch abc))
)

(deflayer symbols-num
  XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  (multi tab (layer-switch numeric)) (multi (unshift grv) (layer-switch numeric)) (multi (unshift lsft grv) (layer-switch numeric)) (multi (unshift lsft 3) (layer-switch numeric)) (multi (unshift lsft 7) (layer-switch numeric)) (multi (unshift lsft \) (layer-switch numeric)) (multi (unshift lsft 6) (layer-switch numeric)) (multi (unshift lsft [) (layer-switch numeric)) (multi (unshift lsft ]) (layer-switch numeric)) (multi (unshift [) (layer-switch numeric)) (multi (unshift ]) (layer-switch numeric)) (multi bspc (layer-switch numeric)) XX XX
  @caps-sym-num (multi (unshift lsft 1) (layer-switch numeric)) (multi (unshift lsft -) (layer-switch numeric)) (multi (unshift lsft ;) (layer-switch numeric)) (multi (unshift =) (layer-switch numeric)) (multi (unshift lsft 4) (layer-switch numeric)) (multi (unshift lsft 2) (layer-switch numeric)) (multi (unshift lsft 9) (layer-switch numeric)) (multi (unshift lsft 0) (layer-switch numeric)) (multi @quote (layer-switch numeric)) (multi ; (layer-switch numeric)) (multi ret (layer-switch numeric)) XX
  lsft (multi (unshift lsft 5) (layer-switch numeric)) (multi (unshift lsft /) (layer-switch numeric)) (multi (unshift lsft 8) (layer-switch numeric)) (multi (unshift lsft =) (layer-switch numeric)) (multi (unshift \) (layer-switch numeric)) (multi (unshift /) (layer-switch numeric)) (multi (unshift -) (layer-switch numeric)) (multi , (layer-switch numeric)) (multi . (layer-switch numeric)) (multi / (layer-switch numeric)) rsft
  lctl lmet lalt (multi spc (layer-switch numeric)) ralt rmet rctl
  (multi esc (layer-switch numeric)) (multi f1 (layer-switch numeric)) (multi f2 (layer-switch numeric)) (multi f3 (layer-switch numeric)) (multi f4 (layer-switch numeric)) (multi f5 (layer-switch numeric)) (multi f6 (layer-switch numeric)) (multi f7 (layer-switch numeric)) (multi f8 (layer-switch numeric)) (multi f9 (layer-switch numeric)) (multi f10 (layer-switch numeric)) (multi f11 (layer-switch numeric)) (multi f12 (layer-switch numeric)) (multi ins (layer-switch numeric)) (multi del (layer-switch numeric)) (multi home (layer-switch numeric)) (multi end (layer-switch numeric)) (multi pgup (layer-switch numeric)) (multi pgdn (layer-switch numeric)) (multi left (layer-switch numeric)) (multi down (layer-switch numeric)) (multi up (layer-switch numeric)) (multi rght (layer-switch numeric))
)

