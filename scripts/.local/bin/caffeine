#!/usr/bin/env bash
# caffeine - keep the screen awake with a systemd idle inhibitor

UNIT="caffeine-inhibit.service"
PROG="$(basename "$0")"

help() {
    cat <<EOF
$PROG - keep the screen awake

Usage:
  $PROG on              stay awake indefinitely
  $PROG off             allow the screen to idle again
  $PROG status          show whether caffeine is active
  $PROG <duration>      stay awake for a set time
  $PROG -h, --help      show this help

Duration examples:
  $PROG 30              30 minutes (plain number = minutes)
  $PROG 90s             90 seconds
  $PROG 2h              2 hours

Manual suspend and lid-close suspend remain enabled.
Requires: systemd (systemd-run, systemctl, systemd-inhibit)
EOF
}

is_active() {
    systemctl --user is-active --quiet "$UNIT"
}

start() {
    local duration="$1"

    if is_active; then
        echo "$PROG: already on"
        return 0
    fi

    if ! systemd-run \
        --user \
        --unit="${UNIT%.service}" \
        --description="Keep the screen awake" \
        --collect \
        --quiet \
        systemd-inhibit \
            --what=idle \
            --mode=block \
            --who="$PROG" \
            --why="Keep the screen awake" \
            sleep "$duration"; then
        echo "$PROG: failed to start" >&2
        return 1
    fi

    if ! is_active; then
        echo "$PROG: failed to acquire the idle inhibitor" >&2
        return 1
    fi

    if [[ $duration == "infinity" ]]; then
        echo "$PROG: on"
    else
        echo "$PROG: on for $duration"
    fi
}

stop() {
    if ! is_active; then
        echo "$PROG: already off"
        return 0
    fi

    if systemctl --user stop "$UNIT"; then
        echo "$PROG: off"
    else
        echo "$PROG: failed to stop" >&2
        return 1
    fi
}

show_status() {
    if is_active; then
        echo "$PROG: on"
    else
        echo "$PROG: off"
    fi
}

for command_name in systemd-run systemctl systemd-inhibit; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "$PROG: error: $command_name not found (requires systemd)" >&2
        exit 1
    fi
done

case "${1:-}" in
    ""|-h|--help|help)
        [[ $# -le 1 ]] || exit 2
        help
        ;;
    on)
        [[ $# -eq 1 ]] || {
            echo "$PROG: 'on' does not accept extra arguments" >&2
            exit 2
        }
        start infinity
        ;;
    off)
        [[ $# -eq 1 ]] || {
            echo "$PROG: 'off' does not accept extra arguments" >&2
            exit 2
        }
        stop
        ;;
    status)
        [[ $# -eq 1 ]] || {
            echo "$PROG: 'status' does not accept extra arguments" >&2
            exit 2
        }
        show_status
        ;;
    *)
        if [[ $# -eq 1 && $1 =~ ^[1-9][0-9]*[smhd]?$ ]]; then
            duration="$1"
            [[ $duration =~ ^[0-9]+$ ]] && duration="${duration}m"
            start "$duration"
        else
            echo "$PROG: unrecognized duration or extra argument" >&2
            echo >&2
            help >&2
            exit 2
        fi
        ;;
esac
