# Read by Hyprland and the jrtilak-layout user service.
# After changing either flag, run: jrtilak-layout apply
# 1 disables Omarchy's Caps-as-Compose mapping; 0 restores the existing code path.
JRTILAK_DISABLE_COMPOSE=1
# 1 enables the physical jrtilak-layout; 0 stops the remapper and restores QWERTY.
JRTILAK_LAYOUT=1
