#!/usr/bin/env bash
set -euo pipefail
layout_dir="${XDG_CONFIG_HOME:-$HOME/.config}/jrtilak-layout"
# This tracked file is shared with the Lua flag reader.
set -a
source "$layout_dir/flags.env"
set +a
case "${1:-status}" in
  run)
    if [[ "${JRTILAK_LAYOUT:-0}" != 1 ]]; then exit 0; fi
    exec "$HOME/.local/bin/kanata" --cfg "$layout_dir/jrtilak-layout.kbd" --no-wait
    ;;
  apply)
    # Validate before changing the active service.
    "$HOME/.local/bin/kanata" --cfg "$layout_dir/jrtilak-layout.kbd" --check
    systemctl --user stop jrtilak-layout.service
    hyprctl reload
    errors="$(hyprctl configerrors)"
    if [[ -n "$errors" && "$errors" != 'ok' ]]; then
      printf '%s\n' "$errors" >&2
      exit 1
    fi
    if [[ "${JRTILAK_LAYOUT:-0}" == 1 ]]; then systemctl --user start jrtilak-layout.service; fi
    ;;
  stop) systemctl --user stop jrtilak-layout.service ;;
  status)
    printf 'JRTILAK_DISABLE_COMPOSE=%s\nJRTILAK_LAYOUT=%s\n' "$JRTILAK_DISABLE_COMPOSE" "$JRTILAK_LAYOUT"
    systemctl --user --no-pager status jrtilak-layout.service
    ;;
  *) printf 'Usage: jrtilak-layout {apply|stop|status}\n' >&2; exit 2 ;;
esac
